  "sourceLanguage": "en",
  "strings": {
    "%@ is damaged. Stenmark won’t change it, so settings you change now will not be saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist beschädigt. Stenmark ändert die Datei nicht, daher werden Einstellungen, die du jetzt änderst, nicht gespeichert."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Файл %@ повреждён. Stenmark не будет его изменять, поэтому настройки, изменённые сейчас, не сохранятся."
          }
        }
      }
    },
