    "A star is a number I can actually see, and it helps others find it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Stern ist eine Zahl, die ich sehen kann, und er hilft anderen, die App zu finden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звезда — это число, которое я реально вижу, и она помогает другим найти приложение."
          }
        }
      }
    },
